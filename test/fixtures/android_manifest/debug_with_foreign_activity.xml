<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.dorogoy.organizer">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application android:name="android.app.Application">
        <activity
            android:name="dev.dorogoy.organizer.MainActivity"
            android:exported="true" />
        <activity
            android:name="com.sneaky.sdk.TrackerActivity"
            android:exported="false"
            android:process=":remote" />
        <activity-alias
            android:name="com.sneaky.sdk.Alias"
            android:targetActivity="com.sneaky.sdk.TrackerActivity" />
    </application>
</manifest>
