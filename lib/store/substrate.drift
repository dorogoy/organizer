-- The insert-only substrate (AD-2): exactly two tables — the task pool and
-- the event log — each refusing UPDATE and DELETE at the database level.
-- Corrections are new entries, never edits; pool retirement is a derivation
-- (AD-25), never a deleted row.
--
-- Every row on both tables carries a shell-minted UUIDv7 id and its instant
-- plus the local offset in force (AD-4), stored as epoch microseconds and
-- offset seconds — no date-only column, no owner column, no third table.
--
-- Schema v2 (Story 2.1) adds the two nullable `setting_changed` payload
-- columns `setting_key`/`setting_value` to log_entries — additive-only,
-- arrived at through ALTER TABLE in onUpgrade (AD-23), so a v1 install
-- upgrades in place with its rows unchanged.
--
-- Schema v3 (Story 2.2) adds the one nullable `session_started` payload
-- column `pocket_minutes` — the declared pocket — the same additive-only
-- ALTER TABLE path, so a v2 install upgrades in place with its rows
-- unchanged.
--
-- Schema v4 (Story 2.5) adds the one nullable `energy_set` payload column
-- `energy_level` — the tapped level's stable wire int — the same additive-only
-- ALTER TABLE path, so a v3 install upgrades in place with its rows
-- unchanged.
--
-- Schema v5 (Story 2.6) adds the two nullable `report_answered` payload
-- columns `report_value`/`report_week` — the weekly self-report's tapped
-- 1–5 answer and the answered week's `Week.weekOrdinal` — the same
-- additive-only ALTER TABLE path, so a v4 install upgrades in place with
-- its rows unchanged.
--
-- Schema v6 (Story 3.2) adds the one nullable pool-fact column
-- `origin_context` — a manual capture's Origin Context, its own single
-- line (AD-14) — the same additive-only ALTER TABLE path, so a v5
-- install upgrades in place with its rows unchanged.
--
-- There are deliberately no FK or CHECK constraints: schema-level
-- constraints would reject the forward-only evolution AD-23 requires — a
-- future build's import must tolerate rows this build does not know, and
-- unknown kinds are preserved verbatim. origin and size are enum-typed at
-- the DTO boundary in DriftStore, and full validation is the core's job
-- at the future read/parse boundary, not the schema's.

CREATE TABLE pool_facts (
  id TEXT NOT NULL PRIMARY KEY,
  origin TEXT NOT NULL,
  size TEXT NOT NULL,
  instant_utc_micros INTEGER NOT NULL,
  offset_seconds INTEGER NOT NULL,
  origin_context TEXT NULL
);

CREATE TABLE log_entries (
  id TEXT NOT NULL PRIMARY KEY,
  kind TEXT NOT NULL,
  instant_utc_micros INTEGER NOT NULL,
  offset_seconds INTEGER NOT NULL,
  item_id TEXT NULL,
  item_origin TEXT NULL,
  stack TEXT NULL,
  setting_key TEXT NULL,
  setting_value INTEGER NULL,
  pocket_minutes INTEGER NULL,
  energy_level INTEGER NULL,
  report_value INTEGER NULL,
  report_week INTEGER NULL
);

CREATE TRIGGER pool_facts_refuse_update BEFORE UPDATE ON pool_facts
BEGIN
  SELECT RAISE(ABORT, 'pool_facts is insert-only (AD-2)');
END;

CREATE TRIGGER pool_facts_refuse_delete BEFORE DELETE ON pool_facts
BEGIN
  SELECT RAISE(ABORT, 'pool_facts is insert-only (AD-2)');
END;

CREATE TRIGGER log_entries_refuse_update BEFORE UPDATE ON log_entries
BEGIN
  SELECT RAISE(ABORT, 'log_entries is insert-only (AD-2)');
END;

CREATE TRIGGER log_entries_refuse_delete BEFORE DELETE ON log_entries
BEGIN
  SELECT RAISE(ABORT, 'log_entries is insert-only (AD-2)');
END;
