# Gradle wrapper injected from the pinned Flutter SDK's cache by
# tool/bootstrap.sh (story 4-2 — the egress seals drive gradlew without
# a prior flutter build). Flutter-managed, never committed; the pinned
# distribution stays in the committed gradle-wrapper.properties.
/android/gradlew
/android/gradlew.bat
/android/gradle/wrapper/gradle-wrapper.jar

# Toolchain provisioned by tool/bootstrap.sh (never committed) — the
# pattern matches both a directory and the machine-shared symlink
.toolchain

# Machine-local environment overrides (opt-in seed etc.) — never committed
tool/env.local.sh

# Devbox environment cache (devbox.json and devbox.lock ARE committed)
.devbox/

# Story 4.1 evaluation harness: corpus photos and raw provider responses are
# machine-local evidence, never committed (prompt, schema, bar and manifest
# metadata ARE committed)
eval/corpus/photos/
eval/results/raw/
