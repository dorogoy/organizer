<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Dictation into the capture line (Story 3.4, FR-32, AD-17): one
         of the three runtime permissions, requested at the moment its
         feature is first used — never at app entry or first run. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- The scan surface's capture (Story 5.2, FR-16, FR-25, AD-17,
         added 2026-09-05 on INTERNET's 4-4 precedent): the CAMERA
         runtime permission, requested by the spine-pinned camera
         plugin at the first scan attempt (opening the scan surface) —
         never at app entry, never during first run. The refusal's
         reversal lives in Settings; the app never re-asks on its own. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- The BYOK Slicer's egress (Story 4-4, AD-7): the one deliberate
         main-manifest permission 4-2's seal anticipated — sockets leave
         only through lib/egress/, and this is the platform's own word
         for allowing them at all. Nothing in first run touches the
         network; the permission guards the slice call alone. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- The face gate's seal-3 surgery (Story 5.1, builder ruling
         2026-09-05, option a): ML Kit's merged manifest brings network-
         facing machinery the app never consented to. Stripped here by
         merger rule, not baselined — detection needs none of it (the
         model is bundled in the APK; see face-gate/results/report.md).
         The minimal ML Kit init set that remains is enumerated, with
         justification, in tool/check_android_manifest.dart.
         (The person-gate amendment's wider strip set — work/room/
         acceleration machinery — was reverted with the deferral of
         gate composition, 2026-09-05: face-only is the interim gate.) -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove"/>
    <!-- CameraX's seal-3 surgery (Story 5.2, 2026-09-05, on 5.1's
         precedent): the camerax closure merges the legacy external-
         storage permission pair, which nothing in this app touches —
         the scan writes only app-private Files storage and the shot
         lands in the camera plugin's own cache. Stripped by merger
         rule, never baselined; CameraX's one init-metadata service
         that remains is enumerated in tool/check_android_manifest.dart. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove"/>
    <application
        android:label="organizer"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    <!-- Face-gate surgery, continued: play-services' account-picker
         activity, datatransport's upload backends, schedulers and
         receiver, the cct backend factory metadata, and the emoji2
         initializer metadata (appcompat via mlkit:common — this
         story's graph addition, not Flutter embedding noise; the
         ruling strips what is ML Kit-related). All removed, none
         baselined; egress stays what 4-4 declared and nothing
         more. -->
    <activity
        android:name="com.google.android.gms.common.api.GoogleApiActivity"
        tools:node="remove"/>
    <service
        android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
        tools:node="remove"/>
    <service
        android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
        tools:node="remove"/>
    <receiver
        android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
        tools:node="remove"/>
    <meta-data
        android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
        tools:node="remove"/>
    <provider
        android:name="androidx.startup.InitializationProvider"
        tools:node="merge">
        <meta-data
            android:name="androidx.emoji2.text.EmojiCompatInitializer"
            tools:node="remove"/>
    </provider>
    <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
